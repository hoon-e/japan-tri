{
  "name": "japan-small-city-roadtrip-randomizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --test",
    "test:unit": "node --test tests/app.test.js tests/data.test.js",
    "test:static": "node --test tests/static.test.js",
    "typecheck": "node --check src/app.js && node --check src/data.js",
    "lint": "node --check src/app.js && node --check src/data.js && node --check tests/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
